{
  "manifest_version": 3,
  "name": "TickBun",
  "version": "0.1.0",
  "description": "TickBun time tracker and break reminder",
  "permissions": [
    "alarms",
    "notifications",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}