{
  "manifest_version": 3,
  "name": "TickBun",
  "version": "0.1.0",
  "description": "TickBun(https://spring-api-starter-production-0867.up.railway.app/) timer setting and break reminder.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://spring-api-starter-production-0867.up.railway.app/*"
    ]
  }
}